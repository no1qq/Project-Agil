<Page
  x:Class="ProjectAgil.Views.Pages.MonitorPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="clr-namespace:ProjectAgil.Controls"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:local="clr-namespace:ProjectAgil.Views.Pages"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  Title="Watch my ping"
  d:DataContext="{d:DesignInstance local:MonitorPage, IsDesignTimeCreatable=False}"
  d:DesignHeight="760"
  d:DesignWidth="1100"
  ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
  ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  FocusVisualStyle="{x:Null}"
  ToolTipService.InitialShowDelay="260"
  ToolTipService.ShowDuration="60000"
  ToolTipService.BetweenShowDelay="120"
  mc:Ignorable="d">

  <Grid Margin="36,18,36,22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="2*" MinHeight="140" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="3*" MinHeight="160" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="0,0,0,14">
      <StackPanel Margin="0,0,130,0">
        <TextBlock Style="{StaticResource PageTitle}" Text="Watch my ping" />
        <TextBlock Style="{StaticResource PageSubtitle}" Text="Live ping to the servers you play on. Rows marked Minecraft are measured the same way the game measures it, so they match the number you see in your server list. Those rows update every few seconds, because a game server starts turning you away if you knock more often than that." />
      </StackPanel>

      <StackPanel
        HorizontalAlignment="Right"
        VerticalAlignment="Center"
        Orientation="Horizontal">
        <ui:Button
          Margin="0,0,6,0"
          Command="{Binding ViewModel.ResetStatsCommand, Mode=OneWay}"
          Icon="{ui:SymbolIcon ArrowReset24}"
          ToolTip="Throw away the numbers so far and start measuring again." />
        <ui:Button
          Command="{Binding ViewModel.ExportCsvCommand, Mode=OneWay}"
          Icon="{ui:SymbolIcon ArrowDownload24}"
          ToolTip="Save every measurement to a spreadsheet file." />
      </StackPanel>
    </Grid>

    <ui:Card
      Grid.Row="1"
      Margin="0,0,0,12"
      Padding="18"
      VerticalAlignment="Stretch"
      VerticalContentAlignment="Stretch">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
          <StackPanel Orientation="Horizontal">
            <TextBlock
              FontSize="16"
              FontWeight="SemiBold"
              Text="{Binding ViewModel.Selected.Name, Mode=OneWay, FallbackValue=No server picked}" />
            <TextBlock
              Margin="10,4,0,0"
              Style="{StaticResource StatCaption}"
              Text="{Binding ViewModel.Selected.Host, Mode=OneWay}" />
          </StackPanel>

          <TextBlock
            HorizontalAlignment="Right"
            FontSize="13"
            FontWeight="Medium"
            Foreground="{Binding ViewModel.Selected.Grade, Converter={StaticResource GradeToBrush}, Mode=OneWay}"
            Text="{Binding ViewModel.Selected.GradeLabel, Mode=OneWay, FallbackValue=measuring}" />
        </Grid>

        <controls:SparklineChart
          Grid.Row="1"
          MinHeight="120"
          AreaBrush="{DynamicResource AgilAccentSoftBrush}"
          GridBrush="{DynamicResource AgilGridBrush}"
          LineBrush="{DynamicResource AgilAccentBrush}"
          LossBrush="{DynamicResource AgilLossBrush}"
          ScaleBrush="{DynamicResource TextFillColorSecondaryBrush}"
          ShowScale="True"
          Values="{Binding ViewModel.History, Mode=OneWay}" />
      </Grid>
    </ui:Card>

    <Grid Grid.Row="2" Margin="0,0,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <ui:Card Grid.Column="0" Padding="16" VerticalContentAlignment="Top">
        <Border Style="{StaticResource HelpHost}" ToolTip="The most recent ping. This is the number you feel in game.">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource StatTitle}" Text="Right now" />
              <ui:SymbolIcon Style="{StaticResource HelpGlyph}" />
            </StackPanel>
            <TextBlock
              Foreground="{Binding ViewModel.Selected.Grade, Converter={StaticResource GradeToBrush}, Mode=OneWay}"
              Style="{StaticResource StatValue}"
              Text="{Binding ViewModel.Selected.CurrentDisplay, Mode=OneWay, FallbackValue=--}" />
          </StackPanel>
        </Border>
      </ui:Card>

      <ui:Card Grid.Column="2" Padding="16" VerticalContentAlignment="Top">
        <Border Style="{StaticResource HelpHost}" ToolTip="Your typical ping over everything measured so far, with the best and worst underneath.">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource StatTitle}" Text="Average" />
              <ui:SymbolIcon Style="{StaticResource HelpGlyph}" />
            </StackPanel>
            <TextBlock Style="{StaticResource StatValue}" Text="{Binding ViewModel.Selected.AverageDisplay, Mode=OneWay, FallbackValue=-}" />
            <TextBlock
              Margin="0,4,0,0"
              Style="{StaticResource StatCaption}"
              Text="{Binding ViewModel.Selected.RangeDisplay, Mode=OneWay}" />
          </StackPanel>
        </Border>
      </ui:Card>

      <ui:Card Grid.Column="4" Padding="16" VerticalContentAlignment="Top">
        <Border Style="{StaticResource HelpHost}" ToolTip="How much your ping jumps around between packets. A jumpy connection feels worse than a high but steady one. Under 5 ms is good.">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource StatTitle}" Text="Jumpiness" />
              <ui:SymbolIcon Style="{StaticResource HelpGlyph}" />
            </StackPanel>
            <TextBlock Style="{StaticResource StatValue}" Text="{Binding ViewModel.Selected.JitterDisplay, Mode=OneWay, FallbackValue=-}" />
            <TextBlock
              Margin="0,4,0,0"
              Style="{StaticResource StatCaption}"
              Text="also called jitter" />
          </StackPanel>
        </Border>
      </ui:Card>

      <ui:Card Grid.Column="6" Padding="16" VerticalContentAlignment="Top">
        <Border Style="{StaticResource HelpHost}" ToolTip="Packets that never came back. Anything above zero causes rubber banding and missed hits.">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource StatTitle}" Text="Lost packets" />
              <ui:SymbolIcon Style="{StaticResource HelpGlyph}" />
            </StackPanel>
            <TextBlock Style="{StaticResource StatValue}" Text="{Binding ViewModel.Selected.LossDisplay, Mode=OneWay, FallbackValue=-}" />
            <TextBlock Margin="0,4,0,0" Style="{StaticResource StatCaption}">
              <Run Text="out of" />
              <Run Text="{Binding ViewModel.Selected.Sent, Mode=OneWay}" />
              <Run Text="sent" />
            </TextBlock>
            <TextBlock
              Margin="0,4,0,0"
              Foreground="{DynamicResource AgilWarnBrush}"
              Style="{StaticResource StatCaption}"
              Text="{Binding ViewModel.Selected.RefusedNote, Mode=OneWay}"
              Visibility="{Binding ViewModel.Selected.RefusedNote, Converter={StaticResource EmptyToVisibility}, Mode=OneWay}" />
          </StackPanel>
        </Border>
      </ui:Card>
    </Grid>

    <ui:Card
      Grid.Row="3"
      Padding="18"
      VerticalAlignment="Stretch"
      VerticalContentAlignment="Stretch">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,8">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <TextBlock
            Grid.Row="0"
            Style="{StaticResource SectionHeader}"
            Text="Servers being watched" />
          <StackPanel
            Grid.Row="0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Orientation="Horizontal">
            <ui:TextBox
              Width="120"
              Margin="0,0,6,0"
              PlaceholderText="Label"
              Text="{Binding ViewModel.NewTargetName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
              ToolTip="A name you will recognise, for example Hypixel." />
            <ui:TextBox
              Width="180"
              Margin="0,0,6,0"
              PlaceholderText="{Binding ViewModel.NewTargetHostPlaceholder, Mode=OneWay}"
              Text="{Binding ViewModel.NewTargetHost, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
              ToolTip="The address you type into Minecraft, for example mc.hypixel.net. Add a port with a colon if the server uses one, like play.example.com:25566." />
            <ui:ToggleSwitch
              Margin="0,0,10,0"
              VerticalAlignment="Center"
              Content="Minecraft server"
              IsChecked="{Binding ViewModel.NewTargetIsMinecraft, Mode=TwoWay}"
              ToolTip="On measures the real in-game ping by talking to the Minecraft server the same way the game does. Off sends a plain network ping, which is all you can do for something that is not a game server." />
            <ui:Button
              Command="{Binding ViewModel.AddTargetCommand, Mode=OneWay}"
              Content="Add"
              Icon="{ui:SymbolIcon Add24}"
              ToolTip="Start watching this server too." />
          </StackPanel>

          <TextBlock
            Grid.Row="1"
            MaxWidth="620"
            Margin="0,2,0,0"
            HorizontalAlignment="Right"
            Style="{StaticResource StatCaption}"
            Text="{Binding ViewModel.NewTargetSummary, Mode=OneWay}"
            TextAlignment="Right" />
        </Grid>

        <ui:ListView
          Grid.Row="1"
          ItemsSource="{Binding ViewModel.Rows, Mode=OneWay}"
          SelectedItem="{Binding ViewModel.Selected, Mode=TwoWay}"
          Style="{StaticResource ListPanel}"
          ToolTip="Click a server to show it in the graph above.">
          <ui:ListView.ItemTemplate>
            <DataTemplate>
              <Grid Margin="0,5">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="86" />
                  <ColumnDefinition Width="86" />
                  <ColumnDefinition Width="86" />
                  <ColumnDefinition Width="86" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock FontWeight="Medium" Text="{Binding Name, Mode=OneWay}" />
                    <Border Style="{StaticResource Pill}" Margin="8,0,0,0">
                      <TextBlock Style="{StaticResource PillText}" Text="{Binding KindDisplay, Mode=OneWay}" />
                    </Border>
                    <Border
                      Style="{StaticResource Pill}"
                      Margin="6,0,0,0"
                      Visibility="{Binding IsPrimary, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                      <TextBlock Style="{StaticResource PillText}" Text="on dashboard" />
                    </Border>
                  </StackPanel>
                  <TextBlock Style="{StaticResource MonoText}" Text="{Binding Host, Mode=OneWay}" />
                </StackPanel>

                <TextBlock
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  FontWeight="SemiBold"
                  Foreground="{Binding Grade, Converter={StaticResource GradeToBrush}, Mode=OneWay}"
                  Text="{Binding CurrentDisplay, Mode=OneWay}" />
                <TextBlock
                  Grid.Column="2"
                  VerticalAlignment="Center"
                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                  Text="{Binding AverageDisplay, Mode=OneWay}" />
                <TextBlock
                  Grid.Column="3"
                  VerticalAlignment="Center"
                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                  Text="{Binding JitterDisplay, Mode=OneWay}" />
                <TextBlock
                  Grid.Column="4"
                  VerticalAlignment="Center"
                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                  Text="{Binding LossDisplay, Mode=OneWay}" />

                <StackPanel
                  Grid.Column="5"
                  VerticalAlignment="Center"
                  Orientation="Horizontal">
                  <ui:Button
                    Margin="0,0,4,0"
                    Command="{Binding DataContext.ViewModel.MakePrimaryCommand, RelativeSource={RelativeSource AncestorType=Page}, Mode=OneWay}"
                    CommandParameter="{Binding Mode=OneWay}"
                    Icon="{ui:SymbolIcon Pin24}"
                    ToolTip="Show this server on the dashboard." />
                  <ui:Button
                    Command="{Binding DataContext.ViewModel.RemoveTargetCommand, RelativeSource={RelativeSource AncestorType=Page}, Mode=OneWay}"
                    CommandParameter="{Binding Mode=OneWay}"
                    Icon="{ui:SymbolIcon Delete24}"
                    ToolTip="Stop watching this server." />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ui:ListView.ItemTemplate>
        </ui:ListView>
      </Grid>
    </ui:Card>
  </Grid>
</Page>

<Page
  x:Class="ProjectAgil.Views.Pages.ToolsPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:local="clr-namespace:ProjectAgil.Views.Pages"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  Title="Fix and check"
  d:DataContext="{d:DesignInstance local:ToolsPage, IsDesignTimeCreatable=False}"
  d:DesignHeight="760"
  d:DesignWidth="1100"
  ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
  ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  FocusVisualStyle="{x:Null}"
  ToolTipService.InitialShowDelay="260"
  ToolTipService.ShowDuration="60000"
  ToolTipService.BetweenShowDelay="120"
  mc:Ignorable="d">

  <Grid Margin="36,18,36,22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,14">
      <TextBlock Style="{StaticResource PageTitle}" Text="Fix and check" />
      <TextBlock Style="{StaticResource PageSubtitle}" Text="Things to try when the connection is misbehaving. Whatever you run, the result shows up on the right." />
    </StackPanel>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="400" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,10,0">

          <ui:Card Margin="0,0,0,12" Padding="18" VerticalContentAlignment="Top">
            <StackPanel>
              <TextBlock Style="{StaticResource SectionHeader}" Text="Try these first" />
              <TextBlock
                Margin="0,0,0,12"
                Style="{StaticResource StatCaption}"
                Text="Safe to run at any time. Nothing here changes a setting, it only clears things Windows has remembered." />

              <ui:Button
                Margin="0,0,0,8"
                HorizontalAlignment="Stretch"
                Command="{Binding ViewModel.FlushDnsCommand, Mode=OneWay}"
                Content="Forget remembered server addresses"
                Icon="{ui:SymbolIcon Broom24}"
                ToolTip="Windows remembers which number belongs to which server name. If a server moved, or you just changed name servers, this makes Windows look everything up fresh." />
              <ui:Button
                Margin="0,0,0,8"
                HorizontalAlignment="Stretch"
                Command="{Binding ViewModel.ClearArpCommand, Mode=OneWay}"
                Content="Forget devices on your network"
                Icon="{ui:SymbolIcon Broom24}"
                ToolTip="Clears the list Windows keeps of the other devices on your home network. Worth trying if the connection to your own router is acting strange." />
              <ui:Button
                HorizontalAlignment="Stretch"
                Command="{Binding ViewModel.RenewLeaseCommand, Mode=OneWay}"
                Content="Ask the router for a fresh address"
                Icon="{ui:SymbolIcon ArrowSync24}"
                ToolTip="Hands your current network address back and asks the router for a new one. Fixes a lot of sudden no internet problems. You drop offline for a second." />
            </StackPanel>
          </ui:Card>

          <ui:Card Margin="0,0,0,12" Padding="18" VerticalContentAlignment="Top" Visibility="{Binding ViewModel.AdvancedMode, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
            <StackPanel>
              <Border Style="{StaticResource HelpHost}" ToolTip="Lists every machine your packets pass through on the way to the server, with the delay at each step. If the ping only jumps after the third or fourth hop, the problem is your provider and not your PC.">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Style="{StaticResource SectionHeader}" Text="See where the delay is" />
                  <ui:SymbolIcon Style="{StaticResource HelpGlyph}" Margin="6,0,0,10" />
                </StackPanel>
              </Border>

              <StackPanel Orientation="Horizontal">
                <ui:TextBox
                  Width="240"
                  PlaceholderText="Server address"
                  Text="{Binding ViewModel.TraceHost, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                  ToolTip="The address you type into Minecraft." />
                <ui:Button
                  Margin="8,0,0,0"
                  Command="{Binding ViewModel.TraceRouteCommand, Mode=OneWay}"
                  Content="Trace"
                  Icon="{ui:SymbolIcon Router24}" />
              </StackPanel>

              <TextBlock
                Margin="0,10,0,0"
                Style="{StaticResource StatCaption}"
                Text="Takes up to a minute. The result appears on the right." />
            </StackPanel>
          </ui:Card>

          <ui:Card Margin="0,0,0,12" Padding="18" VerticalContentAlignment="Top" Visibility="{Binding ViewModel.AdvancedMode, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
            <StackPanel>
              <TextBlock Style="{StaticResource SectionHeader}" Text="Your files" />
              <ui:Button
                Margin="0,0,0,8"
                HorizontalAlignment="Stretch"
                Command="{Binding ViewModel.ExportReportCommand, Mode=OneWay}"
                Content="Save a report about my connection"
                Icon="{ui:SymbolIcon DocumentSave24}"
                ToolTip="Writes a text file with every network setting on this machine. Handy to send to someone who is helping you." />
              <ui:Button
                HorizontalAlignment="Stretch"
                Command="{Binding ViewModel.OpenDataFolderCommand, Mode=OneWay}"
                Content="Open the Project-Agil folder"
                Icon="{ui:SymbolIcon FolderOpen24}"
                ToolTip="Where your undo points, profiles and settings live. Nothing ever leaves this folder." />
            </StackPanel>
          </ui:Card>

          <ui:CardExpander IsExpanded="False" Visibility="{Binding ViewModel.AdvancedMode, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
            <ui:CardExpander.Header>
              <StackPanel>
                <StackPanel Orientation="Horizontal">
                  <ui:SymbolIcon
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource AgilWarnBrush}"
                    Symbol="Warning24" />
                  <TextBlock Style="{StaticResource SettingLabel}" Text="Last resort" />
                </StackPanel>
                <TextBlock
                  Margin="0,3,0,0"
                  Style="{StaticResource StatCaption}"
                  Text="Wipes every network customisation on this PC, including ones Project-Agil never made." />
              </StackPanel>
            </ui:CardExpander.Header>

            <StackPanel Margin="0,4,0,0">
              <TextBlock
                Margin="0,0,0,12"
                Style="{StaticResource StatCaption}"
                Text="Only use these if your networking is genuinely broken. They put Windows back to how it was on the day you installed it, so anything you or another program set up is gone too. Both need a restart afterwards, and Project-Agil cannot undo them." />

              <ui:Button
                Margin="0,0,0,8"
                HorizontalAlignment="Stretch"
                Appearance="Caution"
                Command="{Binding ViewModel.ResetWinsockCommand, Mode=OneWay}"
                Content="Reset how Windows talks to the network"
                Icon="{ui:SymbolIcon Warning24}"
                ToolTip="Rebuilds the list of network helpers Windows loads. Often fixes damage left behind by a VPN or an antivirus that was removed badly." />
              <ui:Button
                HorizontalAlignment="Stretch"
                Appearance="Caution"
                Command="{Binding ViewModel.ResetTcpIpCommand, Mode=OneWay}"
                Content="Reset all internet settings"
                Icon="{ui:SymbolIcon Warning24}"
                ToolTip="Puts every internet setting on this machine back to the Windows default, including every change Project-Agil made." />
            </StackPanel>
          </ui:CardExpander>
        </StackPanel>
      </ScrollViewer>

      <ui:Card
        Grid.Column="2"
        Padding="18"
        VerticalAlignment="Stretch"
        VerticalContentAlignment="Stretch">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <Grid Grid.Row="0">
            <TextBlock Style="{StaticResource SectionHeader}" Text="Result" />
            <ui:Button
              HorizontalAlignment="Right"
              VerticalAlignment="Top"
              Command="{Binding ViewModel.ClearOutputCommand, Mode=OneWay}"
              Content="Clear"
              ToolTip="Empty this panel." />
          </Grid>

          <TextBlock
            Grid.Row="1"
            Margin="0,4,0,0"
            VerticalAlignment="Top"
            Style="{StaticResource StatCaption}"
            Text="Whatever you run on the left shows up here, newest at the top."
            Visibility="{Binding ViewModel.Output.Count, Converter={StaticResource CountToVisibility}, ConverterParameter=invert, Mode=OneWay}" />

          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding ViewModel.Output, Mode=OneWay}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock
                    Margin="0,2"
                    Style="{StaticResource MonoText}"
                    Text="{Binding Mode=OneWay}"
                    TextTrimming="None"
                    TextWrapping="Wrap" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </ui:Card>
    </Grid>
  </Grid>
</Page>

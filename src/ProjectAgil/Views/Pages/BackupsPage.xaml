<Page
  x:Class="ProjectAgil.Views.Pages.BackupsPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:local="clr-namespace:ProjectAgil.Views.Pages"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  Title="Undo points"
  d:DataContext="{d:DesignInstance local:BackupsPage, IsDesignTimeCreatable=False}"
  d:DesignHeight="760"
  d:DesignWidth="1100"
  ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
  ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  FocusVisualStyle="{x:Null}"
  ToolTipService.InitialShowDelay="260"
  ToolTipService.ShowDuration="60000"
  ToolTipService.BetweenShowDelay="120"
  mc:Ignorable="d">

  <Grid Margin="36,18,36,22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="0,0,0,14">
      <StackPanel Margin="0,0,300,0">
        <TextBlock Style="{StaticResource PageTitle}" Text="Undo points" />
        <TextBlock Style="{StaticResource PageSubtitle}">
          <Run Text="Every time Project-Agil changes something it writes down the old value first. Pick a point on the left to see exactly what it would put back." />
        </TextBlock>
      </StackPanel>

      <StackPanel
        HorizontalAlignment="Right"
        VerticalAlignment="Center"
        Orientation="Horizontal">
        <ui:Button
          Margin="0,0,6,0"
          Appearance="Danger"
          Command="{Binding ViewModel.RestoreAllCommand, Mode=OneWay}"
          Content="Undo everything"
          Icon="{ui:SymbolIcon ArrowUndo24}"
          ToolTip="Walks back through every undo point and puts all of it the way it was." />
        <ui:Button
          Command="{Binding ViewModel.RefreshListCommand, Mode=OneWay}"
          Icon="{ui:SymbolIcon ArrowSync24}"
          ToolTip="Load the list of undo points again." />
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="400" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <ui:Card
        Grid.Column="0"
        Padding="14"
        VerticalAlignment="Stretch"
        VerticalContentAlignment="Stretch">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <TextBlock Grid.Row="0" Margin="4,0,4,10" Style="{StaticResource StatCaption}">
            <Run Text="{Binding ViewModel.ActiveCount, Mode=OneWay}" />
            <Run Text="of these have not been undone yet." />
            <Run Text="{Binding ViewModel.ProgressText, Mode=OneWay}" />
          </TextBlock>

          <ui:ListView
            Grid.Row="1"
            ItemsSource="{Binding ViewModel.Snapshots, Mode=OneWay}"
            SelectedItem="{Binding ViewModel.Selected, Mode=TwoWay}"
            Style="{StaticResource ListPanel}">
            <ui:ListView.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,5">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>

                  <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock FontWeight="Medium" Text="{Binding CreatedDisplay, Mode=OneWay}" />
                    <TextBlock Margin="0,3,0,0" Style="{StaticResource StatCaption}">
                      <Run Text="{Binding EntryCount, Mode=OneWay}" />
                      <Run Text="settings   -   " />
                      <Run Text="{Binding Label, Mode=OneWay}" />
                      <Run Text="   -   " />
                      <Run Text="{Binding StatusDisplay, Mode=OneWay}" />
                    </TextBlock>
                  </StackPanel>

                  <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <ui:Button
                      Margin="0,0,4,0"
                      Command="{Binding DataContext.ViewModel.RestoreCommand, RelativeSource={RelativeSource AncestorType=Page}, Mode=OneWay}"
                      CommandParameter="{Binding Mode=OneWay}"
                      Icon="{ui:SymbolIcon ArrowUndo24}"
                      ToolTip="Put back everything saved in this one point." />
                    <ui:Button
                      Command="{Binding DataContext.ViewModel.DeleteCommand, RelativeSource={RelativeSource AncestorType=Page}, Mode=OneWay}"
                      CommandParameter="{Binding Mode=OneWay}"
                      Icon="{ui:SymbolIcon Delete24}"
                      ToolTip="Throw this undo point away. The settings stay as they are, you just lose the ability to undo them." />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ui:ListView.ItemTemplate>
          </ui:ListView>
        </Grid>
      </ui:Card>

      <ui:Card
        Grid.Column="2"
        Padding="18"
        VerticalAlignment="Stretch"
        VerticalContentAlignment="Stretch">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <TextBlock
            Grid.Row="0"
            Style="{StaticResource SectionHeader}"
            Text="What this point would put back" />

          <TextBlock
            Grid.Row="1"
            VerticalAlignment="Top"
            Style="{StaticResource StatCaption}"
            Text="Pick an undo point on the left."
            Visibility="{Binding ViewModel.Entries.Count, Converter={StaticResource CountToVisibility}, ConverterParameter=invert, Mode=OneWay}" />

          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl Margin="0,0,10,0" ItemsSource="{Binding ViewModel.Entries, Mode=OneWay}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border
                    Margin="0,0,0,6"
                    Padding="14,12"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                    <StackPanel>
                      <TextBlock FontWeight="Medium" Text="{Binding TweakName, Mode=OneWay}" />
                      <TextBlock
                        Margin="0,4,0,0"
                        Style="{StaticResource MonoText}"
                        Text="{Binding Target, Mode=OneWay}"
                        TextTrimming="None"
                        TextWrapping="Wrap" />
                      <TextBlock Margin="0,4,0,0" Style="{StaticResource MonoText}">
                        <Run Text="was" />
                        <Run FontWeight="Bold" Text="{Binding PreviousDisplay, Mode=OneWay}" />
                        <Run Text="   changed to" />
                        <Run
                          FontWeight="Bold"
                          Foreground="{DynamicResource AgilAccentBrush}"
                          Text="{Binding AppliedValue, Mode=OneWay}" />
                      </TextBlock>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </ui:Card>
    </Grid>
  </Grid>
</Page>

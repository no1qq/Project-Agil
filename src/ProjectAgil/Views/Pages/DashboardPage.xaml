<Page
  x:Class="ProjectAgil.Views.Pages.DashboardPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="clr-namespace:ProjectAgil.Controls"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:local="clr-namespace:ProjectAgil.Views.Pages"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  Title="Dashboard"
  d:DataContext="{d:DesignInstance local:DashboardPage, IsDesignTimeCreatable=False}"
  d:DesignHeight="760"
  d:DesignWidth="1100"
  ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
  ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  FocusVisualStyle="{x:Null}"
  ToolTipService.InitialShowDelay="260"
  ToolTipService.ShowDuration="60000"
  ToolTipService.BetweenShowDelay="120"
  mc:Ignorable="d">

  <ScrollViewer
    x:Name="Scroller"
    Margin="36,18,36,22"
    VerticalScrollBarVisibility="Auto">
    <Grid
      Height="{Binding ViewportHeight, ElementName=Scroller, Mode=OneWay}"
      MinHeight="580">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,14">
      <TextBlock Style="{StaticResource PageTitle}" Text="Dashboard" />
      <TextBlock Style="{StaticResource PageSubtitle}" Text="How your connection is doing right now, and how much of it Project-Agil has tuned." />
    </StackPanel>

    <StackPanel Grid.Row="1">
      <ui:InfoBar
        Margin="0,0,0,14"
        IsClosable="False"
        IsOpen="{Binding ViewModel.ShowElevationWarning, Mode=OneWay}"
        Message="Windows will not let Project-Agil change network settings unless it runs as administrator. Close it, right click the icon and pick Run as administrator."
        Severity="Warning"
        Title="Not running as administrator" />

      <ui:InfoBar
        Margin="0,0,0,14"
        IsClosable="False"
        IsOpen="{Binding ViewModel.UpdateAvailable, Mode=OneWay}"
        Message="A newer build of Project-Agil is ready. Updating downloads it and restarts the app. Your settings, saved setups and undo points are kept."
        Severity="Informational"
        Title="An update is available">
        <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
          <ui:Button
            Appearance="Primary"
            Command="{Binding ViewModel.InstallUpdateCommand, Mode=OneWay}"
            Content="Update now"
            Icon="{ui:SymbolIcon ArrowDownload24}"
            IsEnabled="{Binding ViewModel.UpdateBusy, Converter={StaticResource InverseBool}, Mode=OneWay}" />
          <TextBlock
            Margin="12,0,0,0"
            VerticalAlignment="Center"
            Style="{StaticResource StatCaption}"
            Text="{Binding ViewModel.UpdateState, Mode=OneWay}" />
        </StackPanel>
      </ui:InfoBar>
    </StackPanel>

    <Grid Grid.Row="2" Margin="0,0,0,14">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="14" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="14" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <ui:Card
        Grid.Column="0"
        Padding="18"
        VerticalContentAlignment="Top">
        <StackPanel>
          <Border
            Style="{StaticResource HelpHost}"
            HorizontalAlignment="Left"
            ToolTip="Project-Agil checks every setting it knows about and compares it with the value it would set. 100% means there is nothing left to change.">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource StatTitle}" Text="Tuned" />
              <ui:SymbolIcon Style="{StaticResource HelpGlyph}" />
            </StackPanel>
          </Border>

          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource StatValue}" Text="{Binding ViewModel.OptimizationPercent, Mode=OneWay, StringFormat={}{0:0}}" />
            <TextBlock
              Margin="3,0,0,5"
              VerticalAlignment="Bottom"
              FontSize="15"
              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
              Text="%" />
          </StackPanel>

          <ProgressBar
            Height="4"
            Margin="0,8,0,10"
            Foreground="{DynamicResource AgilAccentBrush}"
            Maximum="100"
            Value="{Binding ViewModel.OptimizationPercent, Mode=OneWay}" />

          <TextBlock Style="{StaticResource StatCaption}">
            <Run Text="{Binding ViewModel.OptimizedCount, Mode=OneWay}" />
            <Run Text="of" />
            <Run Text="{Binding ViewModel.PlanCount, Mode=OneWay}" />
            <Run Text="settings already changed" />
          </TextBlock>
        </StackPanel>
      </ui:Card>

      <ui:Card
        Grid.Column="2"
        Padding="18"
        VerticalContentAlignment="Top">
        <StackPanel>
          <Border
            Style="{StaticResource HelpHost}"
            HorizontalAlignment="Left"
            ToolTip="The network card your computer is using to reach the internet. This is the one Project-Agil tunes.">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource StatTitle}" Text="Your connection" />
              <ui:SymbolIcon Style="{StaticResource HelpGlyph}" />
            </StackPanel>
          </Border>

          <TextBlock
            Margin="0,6,0,0"
            FontSize="19"
            FontWeight="SemiBold"
            Text="{Binding ViewModel.AdapterName, Mode=OneWay}"
            TextTrimming="CharacterEllipsis" />
          <TextBlock
            Margin="0,6,0,0"
            Style="{StaticResource StatCaption}"
            Text="{Binding ViewModel.AdapterDetail, Mode=OneWay}" />
        </StackPanel>
      </ui:Card>

      <ui:Card
        Grid.Column="4"
        Padding="18"
        VerticalContentAlignment="Top">
        <StackPanel>
          <Border
            Style="{StaticResource HelpHost}"
            HorizontalAlignment="Left"
            ToolTip="How long a packet takes to reach the server and come back. For a Minecraft server this is measured the same way the game measures it, so it matches the number in your server list. Lower is better.">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource StatTitle}" Text="Ping right now" />
              <ui:SymbolIcon Style="{StaticResource HelpGlyph}" />
            </StackPanel>
          </Border>

          <TextBlock
            Foreground="{Binding ViewModel.Primary.Grade, Converter={StaticResource GradeToBrush}, Mode=OneWay}"
            Style="{StaticResource StatValue}"
            Text="{Binding ViewModel.Primary.CurrentDisplay, Mode=OneWay, FallbackValue=--}" />

          <Border
            Style="{StaticResource HelpHost}"
            Margin="0,8,0,0"
            HorizontalAlignment="Left"
            ToolTip="Average is your typical ping. Jumpiness is how much it moves around, and a jumpy ping feels worse than a high steady one. Lost is packets that never came back.">
            <StackPanel>
              <TextBlock Style="{StaticResource StatCaption}" TextWrapping="NoWrap">
                <Run Text="average" />
                <Run Text="{Binding ViewModel.Primary.AverageDisplay, Mode=OneWay, FallbackValue=-}" />
              </TextBlock>
              <TextBlock
                Margin="0,3,0,0"
                Style="{StaticResource StatCaption}"
                TextWrapping="NoWrap">
                <Run Text="jumpiness" />
                <Run Text="{Binding ViewModel.Primary.JitterDisplay, Mode=OneWay, FallbackValue=-}" />
                <Run Text="   lost" />
                <Run Text="{Binding ViewModel.Primary.LossDisplay, Mode=OneWay, FallbackValue=-}" />
              </TextBlock>
              <TextBlock
                Margin="0,3,0,0"
                MaxWidth="260"
                Foreground="{DynamicResource AgilWarnBrush}"
                Style="{StaticResource StatCaption}"
                Text="{Binding ViewModel.Primary.RefusedNote, Mode=OneWay}"
                Visibility="{Binding ViewModel.Primary.RefusedNote, Converter={StaticResource EmptyToVisibility}, Mode=OneWay}" />
            </StackPanel>
          </Border>

          <TextBlock
            Margin="0,6,0,0"
            Style="{StaticResource StatCaption}"
            Text="{Binding ViewModel.MonitorTarget, Mode=OneWay}"
            TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </ui:Card>
    </Grid>

    <ui:Card
      Grid.Row="3"
      Margin="0,0,0,14"
      Padding="18"
      VerticalAlignment="Stretch"
      VerticalContentAlignment="Stretch">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
          <TextBlock Style="{StaticResource SectionHeader}" Text="Ping over time" />
          <TextBlock
            HorizontalAlignment="Right"
            FontSize="13"
            FontWeight="Medium"
            Foreground="{Binding ViewModel.Primary.Grade, Converter={StaticResource GradeToBrush}, Mode=OneWay}"
            Text="{Binding ViewModel.Primary.GradeLabel, Mode=OneWay, FallbackValue=measuring}" />
        </Grid>

        <controls:SparklineChart
          Grid.Row="1"
          MinHeight="110"
          AreaBrush="{DynamicResource AgilAccentSoftBrush}"
          GridBrush="{DynamicResource AgilGridBrush}"
          LineBrush="{DynamicResource AgilAccentBrush}"
          LossBrush="{DynamicResource AgilLossBrush}"
          ScaleBrush="{DynamicResource TextFillColorSecondaryBrush}"
          ShowScale="True"
          Values="{Binding ViewModel.History, Mode=OneWay}" />
      </Grid>
    </ui:Card>

    <ui:Card Grid.Row="4" Padding="18" VerticalContentAlignment="Top">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
          Grid.Row="0"
          Grid.Column="0"
          Margin="0,0,16,0"
          VerticalAlignment="Center"
          Style="{StaticResource SettingLabel}"
          Text="What do you want to do?" />

        <TextBlock
          Grid.Row="1"
          Grid.Column="0"
          Grid.ColumnSpan="2"
          Margin="0,10,0,0"
          Style="{StaticResource StatCaption}">
          <Run Text="Every change is saved first, so you can always put it back." />
          <Run Text="{Binding ViewModel.RestorePointCount, Mode=OneWay}" />
          <Run Text="undo points saved." />
        </TextBlock>

        <StackPanel
          Grid.Row="0"
          Grid.Column="1"
          Orientation="Horizontal"
          VerticalAlignment="Center">
          <ui:Button
            Margin="0,0,8,0"
            Appearance="Primary"
            Command="{Binding ViewModel.OpenOptimizeCommand, Mode=OneWay}"
            Content="Optimize"
            Icon="{ui:SymbolIcon Flash24}"
            ToolTip="Pick how aggressive the tuning should be, then apply it." />
          <ui:Button
            Margin="0,0,8,0"
            Command="{Binding ViewModel.OpenMonitorCommand, Mode=OneWay}"
            Content="Watch ping"
            Icon="{ui:SymbolIcon PulseSquare24}"
            ToolTip="Live ping graph for the servers you care about." />
          <ui:Button
            Margin="0,0,8,0"
            Command="{Binding ViewModel.RefreshCommand, Mode=OneWay}"
            Icon="{ui:SymbolIcon ArrowSync24}"
            ToolTip="Read all the current settings from Windows again." />
          <ui:Button
            Appearance="Danger"
            Command="{Binding ViewModel.RevertAllCommand, Mode=OneWay}"
            Content="Undo everything"
            Icon="{ui:SymbolIcon ArrowUndo24}"
            IsEnabled="{Binding ViewModel.HasRestorePoint, Mode=OneWay}"
            ToolTip="Puts every setting Project-Agil changed back exactly how it was before." />
        </StackPanel>
      </Grid>
    </ui:Card>
    </Grid>
  </ScrollViewer>
</Page>

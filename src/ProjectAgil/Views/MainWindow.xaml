<ui:FluentWindow
  x:Class="ProjectAgil.Views.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:local="clr-namespace:ProjectAgil.Views"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:tray="http://schemas.lepo.co/wpfui/2022/xaml/tray"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  Title="{Binding ViewModel.ApplicationTitle, Mode=OneWay}"
  Width="1180"
  Height="760"
  MinWidth="900"
  MinHeight="600"
  d:DataContext="{d:DesignInstance local:MainWindow, IsDesignTimeCreatable=True}"
  ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
  ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  ExtendsContentIntoTitleBar="True"
  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  RenderOptions.ClearTypeHint="Enabled"
  TextOptions.TextRenderingMode="ClearType"
  UseLayoutRounding="True"
  WindowBackdropType="Mica"
  WindowCornerPreference="Round"
  WindowStartupLocation="CenterScreen"
  mc:Ignorable="d">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <ui:NavigationView
      x:Name="RootNavigation"
      Grid.Row="1"
      FooterMenuItemsSource="{Binding ViewModel.NavigationFooter, Mode=OneWay}"
      IsBackButtonVisible="Collapsed"
      MenuItemsSource="{Binding ViewModel.NavigationItems, Mode=OneWay}"
      OpenPaneLength="228"
      PaneDisplayMode="Left"
      Transition="None"
      TransitionDuration="0" />

    <ui:ContentDialogHost
      x:Name="RootContentDialog"
      Grid.Row="0"
      Grid.RowSpan="2" />

    <ui:SnackbarPresenter
      x:Name="RootSnackbar"
      Grid.Row="1"
      Margin="0,0,0,24" />

    <ui:TitleBar
      x:Name="TitleBar"
      Title="{Binding ViewModel.ApplicationTitle, Mode=OneWay}"
      Grid.Row="0">
      <ui:TitleBar.Icon>
        <ui:ImageIcon
          RenderOptions.BitmapScalingMode="HighQuality"
          Source="{DynamicResource AppIconImage}" />
      </ui:TitleBar.Icon>
    </ui:TitleBar>

    <tray:NotifyIcon
      Grid.Row="0"
      FocusOnLeftClick="True"
      Icon="{StaticResource AppTrayIcon}"
      MenuOnRightClick="True"
      TooltipText="Project-Agil">
      <tray:NotifyIcon.Menu>
        <ContextMenu ItemsSource="{Binding ViewModel.TrayMenuItems, Mode=OneWay}" />
      </tray:NotifyIcon.Menu>
    </tray:NotifyIcon>
  </Grid>
</ui:FluentWindow>
